# Editor / tooling artifacts
.cache/
# .clang-format and .clang-tidy are symlinks into the duckdb submodule, and they
# are COMMITTED. CI's format-check job never builds, so nothing recreates them
# there; without them clang-format falls back to its LLVM default and demands
# two-space indent for a codebase DuckDB formats with tabs. Git stores the
# symlink and the submodule supplies the target.
/.editorconfig

# Browser test dependencies (duckdb-wasm bundles + playwright)
test/browser/node_modules/
test/browser/public/bundle.js
web/wasm/
