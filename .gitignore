# vcpkg materializes these at the repo root when a build resolves the manifest.
vcpkg/
vcpkg_installed/

# .clang-format, .clang-tidy and .editorconfig are symlinks into the duckdb
# submodule, and they are COMMITTED. CI's format-check job never builds, so
# nothing recreates them there; without them clang-format falls back to its LLVM
# default and demands two-space indent for a codebase DuckDB formats with tabs.
# Git stores the symlink and the submodule supplies the target.

