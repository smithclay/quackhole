build
.idea
cmake-build-debug
duckdb_unittest_tempdir/
.DS_Store
testext
__pycache__/
.Rhistory

# Rust core build output
crates/target/
# Persisted iroh endpoint key (the address); never commit
.quackhole/

# Editor / tooling artifacts
.cache/
.ccache/

# vcpkg materializes these at the repo root when a build resolves the manifest.
vcpkg/
vcpkg_installed/

# .clang-format, .clang-tidy and .editorconfig are symlinks into the duckdb
# submodule, and they are COMMITTED. CI's format-check job never builds, so
# nothing recreates them there; without them clang-format falls back to its LLVM
# default and demands two-space indent for a codebase DuckDB formats with tabs.
# Git stores the symlink and the submodule supplies the target.

# Browser test dependencies (duckdb-wasm bundles + playwright)
test/browser/node_modules/
test/browser/public/bundle.js
web/wasm/

# The GitHub Pages demo is assembled, not committed: dist/ is built by
# site/build.mjs out of site/, web/, web/wasm/ and node_modules.
site/node_modules/
site/dist/

# The npm package is assembled too: npm/dist/ is built by npm/build.mjs out of
# npm/src/ and web/, and npm/ has its own node_modules for the CLI's bindings.
npm/node_modules/
npm/dist/
# Copied from the repo root by build.mjs: npm only reads a LICENSE at the
# package root, and `files` cannot reach one a directory up.
npm/LICENSE
npm/*.tgz
