# name: test/sql/quackhole.test
# description: Load, catalog surface, and the not-yet-bound status/stop/attach paths
# group: [sql]

# Before loading, none of the functions exist.
statement error
CALL quackhole_status();
----
Catalog Error

require quackhole

# All four table functions are registered.
query I
SELECT count(*) FROM duckdb_functions()
WHERE function_name IN ('quackhole_serve', 'quackhole_attach', 'quackhole_stop', 'quackhole_status');
----
4

# Asking for status must not bind an endpoint as a side effect: before anything
# has dialed or served, we report an empty status rather than creating a key and
# publishing an address.
query III
SELECT endpoint_id, serving, peer_id FROM quackhole_status();
----
NULL	false	NULL

# Stopping when nothing is serving is a clean false, not an error.
query I
SELECT stopped FROM quackhole_stop();
----
false

# Status is repeatable and still does not bind.
query I
SELECT serving FROM quackhole_status();
----
false

# quackhole_attach reads the ticket before it binds anything, so a typo is
# rejected without an endpoint key being created and an address published as a
# side effect. That ordering is what lets these live in the ungated file.
statement error
CALL quackhole_attach('not a ticket at all, just some prose about tickets');
----
<REGEX>:.*Look for the string starting with qh1_.*

# The mistake worth naming, because it is the string someone who has read the
# README reaches for -- and it is exactly the one that carries no relay.
statement error
CALL quackhole_attach('et8u6wsyz7qiqm1pb5q3zgny43oro4gbr8rkfdkskpts7mtmehwy');
----
<REGEX>:.*endpoint id, not a ticket.*

# base64url of `notjson`: shaped like a ticket, decodes to nothing.
statement error
CALL quackhole_attach('qh1_bm90anNvbg');
----
<REGEX>:.*damaged.*

# The alias is interpolated into ATTACH ... AS, so an empty one is refused at
# bind rather than producing a statement that will not parse.
statement error
CALL quackhole_attach('qh1_bm90anNvbg', name := '');
----
<REGEX>:.*name must not be empty.*

# None of that bound an endpoint.
query II
SELECT endpoint_id IS NULL, serving FROM quackhole_status();
----
true	false

# A relay list that will not parse is refused where the endpoint would have been
# bound, and the message names the URL that did not parse. Left to iroh it would
# have surfaced as a bind failure with the setting nowhere in it.
statement ok
SET GLOBAL quackhole_relays = 'nonsense';

statement error
CALL quackhole_serve(auto_serve := false);
----
<REGEX>:.*'nonsense' is not a valid relay url.*

# And it bound nothing on the way out: a rejected relay list must not leave an
# endpoint published on n0's relays instead.
query II
SELECT endpoint_id IS NULL, serving FROM quackhole_status();
----
true	false

statement ok
SET GLOBAL quackhole_relays = '';
