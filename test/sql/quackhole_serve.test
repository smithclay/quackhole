# name: test/sql/quackhole_serve.test
# description: serve/stop lifecycle, key_path persistence, and the ephemeral guard
# group: [sql]

#
# Binding an iroh endpoint opens a UDP socket and publishes an address, so this
# file is gated like the other live tests.

require quackhole

require-env QUACKHOLE_NET_TESTS

# Keep the endpoint key out of ~/.quackhole so the suite never touches the
# developer's real identity.
statement ok
SET GLOBAL quackhole_key_path = '__TEST_DIR__/quackhole_test_key';

statement ok
SET GLOBAL quackhole_ephemeral = false;

# This file is about the serve/stop lifecycle, and never reads the ticket or the
# link. Waiting for a home relay would add ten seconds per call here for a
# column nothing below asserts on.
statement ok
SET GLOBAL quackhole_relay_wait_ms = 0;

# auto_serve := false because this test is about quackhole's own lifecycle, not
# about whether a Quack server happens to come up. Captured rather than CALLed
# so the attach_sql assertions below have something to read -- serve can only be
# called once, so there is no second chance to look at its output.
statement ok
CREATE TABLE srv AS SELECT * FROM quackhole_serve(auto_serve := false, target := '127.0.0.1:9494');

# attach_sql has to be paste-ready into a DuckDB that already holds another
# remote, which means naming the secret after the peer: an unnamed quack secret
# is really `__default_quack`, so a second CREATE SECRET fails on the name
# whatever its scope says.
query I
SELECT attach_sql LIKE 'CREATE SECRET qh_' || endpoint_id || ' (TYPE quack,%' FROM srv;
----
true

# The invariant that is not obvious from reading the string: the scope and the
# address dialled are the same. If they drift, the token is filed under a path
# nothing attaches to and the failure reads "Could not find a Quack
# authentication token", which does not sound like a scope problem.
query I
SELECT regexp_extract(attach_sql, 'SCOPE ''([^'']*)''', 1)
     = regexp_extract(attach_sql, 'ATTACH ''([^'']*)''', 1)
FROM srv;
----
true

query I
SELECT serving FROM quackhole_status();
----
true

# The printed id is z-base-32, which fits a DNS label.
query I
SELECT length(endpoint_id) FROM quackhole_status();
----
52

# quackhole_key_path was honoured: the key exists where we asked for it, not in
# the default location.
query I
SELECT count(*) FROM glob('__TEST_DIR__/quackhole_test_key');
----
1

# Asking for a throwaway identity once an endpoint is already bound must fail
# loudly. Silently serving on the long-lived, published key instead is exactly
# the surprise someone passing `ephemeral` is trying to avoid.
statement error
CALL quackhole_serve(ephemeral := true, auto_serve := false);
----
<REGEX>:.*ephemeral.*

# Starting twice is refused rather than silently replacing the accept loop.
statement error
CALL quackhole_serve(auto_serve := false, target := '127.0.0.1:9494');
----
<REGEX>:.*already serving.*

# Stopping while actually serving reports true (the not-serving case is covered
# in quackhole.test, which reports false).
query I
SELECT stopped FROM quackhole_stop();
----
true

# is_serving reflects the accept loop, not merely "stop was never called".
query I
SELECT serving FROM quackhole_status();
----
false

# The endpoint stays bound after stopping, so outbound dials still work.
query I
SELECT endpoint_id IS NOT NULL FROM quackhole_status();
----
true

# Serving again on the same core is allowed once stopped.
statement ok
CALL quackhole_serve(auto_serve := false, target := '127.0.0.1:9494');

query I
SELECT serving FROM quackhole_status();
----
true

statement ok
CALL quackhole_stop();
